{
  "schema_version": "1.0.0",
  "record_type": "sandbox_validation_profile",
  "profile_id": "stegtalk-wiki-default",
  "repository": "StegVerse-Labs/stegtalk-wiki",
  "timeout_seconds": 180,
  "exclude": [".git", "__pycache__", ".pytest_cache", "reports", "_site"],
  "commands": [
    {
      "id": "compile-python",
      "argv": ["python", "-m", "compileall", "scripts", "tools"],
      "expected_exit": 0,
      "rationale": "Detect syntax failures before hosted publication validation."
    },
    {
      "id": "validate-documentation-mesh",
      "argv": ["python", "scripts/check_documentation_mesh.py"],
      "expected_exit": 0,
      "rationale": "Run the repository's existing documentation and shared-schema validator."
    },
    {
      "id": "validate-pages-contract",
      "argv": ["python", "tools/check_pages_contract.py"],
      "expected_exit": 0,
      "rationale": "Verify the single workflow preserves PR validation, main-only deployment, publication paths, and report upload."
    },
    {
      "id": "validate-st017-adoption",
      "argv": ["python", "tools/validate_st017_adoption.py", "--structural-only"],
      "expected_exit": 0,
      "rationale": "Prove ST-017 profile, runner, workflow, handoff, and evidence boundaries are installed without recursive sandbox execution."
    }
  ]
}
